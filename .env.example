# Copy to .env. Never commit .env.
DATABASE_URL=postgresql+psycopg://riskminer:riskminer@localhost:55432/riskminer
POSTGRES_PASSWORD=riskminer
DB_PORT=55432
SETTINGS_FILE=config/settings.yaml
# live | cache | replay  (overrides llm.mode in settings.yaml)
LLM_MODE=cache
SECRET_KEY=change-me
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5180
# public host name for Caddy (e.g. 1.2.3.4.sslip.io)
DOMAIN=localhost

# LLM keys (only the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=ollama
